#version 450

// SiLU (Swish) activation: output = x * sigmoid(x)
// where sigmoid(x) = 1 / (1 + exp(-x))
// So: silu(x) = x / (1 + exp(-x))

layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint LOCAL_SIZE_X = 1; // set at pipeline creation from hardware

layout(binding = 0) readonly buffer BufferInput { float input_data[]; };
layout(binding = 1) buffer BufferOutput { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint size;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.size) return;

    float x = input_data[idx];

    // SiLU: x * sigmoid(x) = x / (1 + exp(-x))
    output_data[idx] = x / (1.0 + exp(-x));
}
