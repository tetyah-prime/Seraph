#version 450

// Reduce sum of float array.
// out[group] = sum(in[group*512 + i]) for i in [0,511] (bounds checked).
//
// Intended to be called repeatedly (ping-pong buffers) until count == 1.

layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint LOCAL_SIZE_X = 1; // set at pipeline creation from hardware

layout(binding = 0) readonly buffer BufferIn { float in_data[]; };
layout(binding = 1) writeonly buffer BufferOut { float out_data[]; };

layout(push_constant) uniform PushConstants {
    uint count;
} params;

shared float s_sum[LOCAL_SIZE_X];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint group = gl_WorkGroupID.x;
    uint wg_size = gl_WorkGroupSize.x;

    uint base = group * (2 * wg_size);

    float v0 = 0.0;
    float v1 = 0.0;
    uint i0 = base + tid;
    uint i1 = base + tid + wg_size;
    if (i0 < params.count) v0 = in_data[i0];
    if (i1 < params.count) v1 = in_data[i1];

    s_sum[tid] = v0 + v1;
    barrier();

    for (uint stride = wg_size / 2; stride > 0; stride >>= 1) {
        if (tid < stride) s_sum[tid] += s_sum[tid + stride];
        barrier();
    }

    if (tid == 0) out_data[group] = s_sum[0];
}

